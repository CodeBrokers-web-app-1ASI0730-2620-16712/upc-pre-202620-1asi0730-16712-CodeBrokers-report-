@startuml
title Class Diagram - Bounded Context: Marketing
!include _style.iuml

package VitaLink.Marketing {
 package Domain {

  package Repositories {
    interface IContactRequestRepository <<Repository (Interface)>> {
      + FindByIdAsync(id: ContactRequestId) : Task<ContactRequest?>
      + FindByStatusAsync(status: LeadStatus) : Task<IReadOnlyList<ContactRequest>>
      + ExistsRecentByEmailAsync(email: Email, within: TimeSpan) : Task<bool>
      + SaveAsync(request: ContactRequest) : Task<ContactRequest>
    }
  }

  package Services {
    class DuplicateLeadPolicy <<Specification>> {
      + IsSatisfiedBy(email: Email) : bool
      + Reason() : string
    }
  }

  package Model {

   package Aggregates {
    entity ContactRequest <<Aggregate Root>> {
      - id : ContactRequestId
      - fullName : string
      - email : Email
      - specialty : Specialty?
      - segment : VisitorSegment
      - message : string?
      - status : LeadStatus
      - receivedAt : DateTimeOffset
      - attendedAt : DateTimeOffset?
      --
      + ContactRequest(fullName: string, email: Email, segment: VisitorSegment)
      + DeclareSpecialty(specialty: Specialty) : void
      + AttachMessage(message: string) : void
      + MarkAsAttended() : void
      + Discard(reason: string) : void
      + IsPending() : bool
      - EnsureStillPending() : void
    }
   }

   package ValueObjects {
    class ContactRequestId <<Value Object (Record)>> {
      + Value : Guid
      --
      + {static} New() : ContactRequestId
    }
    class Specialty <<Value Object (Record)>> {
      + Value : string
      --
      + Specialty(value: string)
    }
    enum VisitorSegment <<Enumeration>> {
      CARE_PROVIDER
      FAMILY_CAREGIVER
    }
    enum LeadStatus <<Enumeration>> {
      PENDING
      ATTENDED
      DISCARDED
    }
   }

   package Events {
    class ContactRequestReceived <<Domain Event (Record)>> {
      + ContactRequestId : ContactRequestId
      + Email : Email
      + Segment : VisitorSegment
      + OccurredOn : DateTimeOffset
    }
   }
  }
 }
}

package "Referencias externas (por identidad)" {
  class Email <<Value Object (Record)>> {
    + Value : string
  }
}

